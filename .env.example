# Настройки делегирования кода китайским моделям
# Вариант 1 (Рекомендуется): OpenRouter — даёт доступ сразу к DeepSeek, Kimi, Qwen и GLM по одному ключу
# Получить ключ: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-ВСТАВЬ_СВОЙ_КЛЮЧ_СЮДА

# Вариант 2 (Опционально): Прямой ключ с https://platform.deepseek.com/api_keys
# Используется, если не указан OPENROUTER_API_KEY
DEEPSEEK_API_KEY=
